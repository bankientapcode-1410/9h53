# ==========================================
# Git Ignore for SmartPC Monorepo Project
# ==========================================

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor Files
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.classpath
.project
.settings/

# Node & Frontend Build Artifacts
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.cache/
frontend/*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Java & Backend Build Artifacts
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.war
*.ear
*.jar

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.env
application-local.yml
application-secrets.yml

# Database / Storage Volumes
docker/data/
postgres-data/
redis-data/
*.db
*.sqlite

# Logs
logs/
*.log

# Temporary & Test Reports
backend/surefire-reports/
coverage/
.nyc_output/
