# =============================================================================
# SmartPC Environment Configuration Template
# Sao chép file này thành .env hoặc .env.local và điền các giá trị thực tế
# =============================================================================

# Google Gemini AI API Key (Dùng cho Chatbot tư vấn phần cứng & Semantic Search)
# Đăng ký và lấy API Key miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smartpc
DB_USER=root
DB_PASSWORD=root

